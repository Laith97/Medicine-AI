# Local Development Environment Configuration
# This file overrides .env for local development
# Copy from .env.local.example and customize for your local setup

APP_NAME="MedCura AI (Local)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=base64:kg5VW6kaR8e91Z2JeyUL8wmOjPD6tfUMTQqw8suqFGA=

# Database - Keep your existing database settings
# The main .env file has the database configuration

# Mailtrap Configuration for Local Email Testing
# IMPORTANT: Replace the credentials below with your actual Mailtrap credentials
# 1. Sign up at https://mailtrap.io (free)
# 2. Create a new inbox
# 3. Copy the SMTP credentials from Mailtrap dashboard
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username_here
MAIL_PASSWORD=your_mailtrap_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="test@medcuraai.com"
MAIL_FROM_NAME="MedCura AI (Local Test)"

# Use sync queue for local development (emails sent immediately)
QUEUE_CONNECTION=sync

# Other configurations...
LOG_LEVEL=debug
BROADCAST_CONNECTION=log

# Keep your existing OpenAI and Stripe keys from .env
# OPENAI_API_KEY=...
# STRIPE_KEY=...
# STRIPE_SECRET=...

# Instructions:
# 1. Replace MAIL_USERNAME and MAIL_PASSWORD with your Mailtrap credentials
# 2. Test email sending with: php artisan email:test your-email@example.com
# 3. Check your Mailtrap inbox to see test emails
# 4. For production, use the settings in .env.production