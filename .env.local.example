# Local Development Environment Configuration
# Copy this file to .env.local for local development settings

APP_NAME="MedCura AI (Local)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (use SQLite for local development)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Mailtrap Configuration for Local Email Testing
# Sign up at https://mailtrap.io and create an inbox
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="test@medcuraai.com"
MAIL_FROM_NAME="MedCura AI (Local Test)"

# Other configurations...
LOG_LEVEL=debug
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# OpenAI (use test key or limit usage)
OPENAI_API_KEY=your_test_openai_key

# Stripe (use test keys)
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...